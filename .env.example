# Copy to .env. Secrets stay on the backend and are never sent to the frontend.

# development | test | production. Production refuses the mock provider and error injection.
APP_ENV=development

# Default is a local SQLite file. For Postgres:
#   postgresql+psycopg://lessons:lessons@localhost:5432/lessons
DATABASE_URL=sqlite:///./data/lessons.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM provider ---------------------------------------------------------
# gemini | anthropic | openai | mock
# Changing vendor or key later only needs an edit here and a backend restart.
# "mock" is a labelled, rule-based stand-in for trying the system without a key.
LLM_PROVIDER=gemini

# Gemini key. GEMINI_API_KEY is accepted as well.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: use a different vendor for the evaluator than for the generator.
# EVALUATOR_PROVIDER=

# Defaults: gemini-3.8-flash for Gemini and claude-opus-5-5 for Anthropic. OpenAI has no
# default, so set these for it. Current IDs: https://ai.google.dev/gemini-api/docs/models
GENERATOR_MODEL=gemini-3.8-flash
EVALUATOR_MODEL=gemini-3.8-flash

LLM_TIMEOUT_SECONDS=300
LLM_PROVIDER_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=16000

# Claude only: effort level (low | medium | high | xhigh | max) and server-side refusal fallback.
# ANTHROPIC_EFFORT=high
# ANTHROPIC_REFUSAL_FALLBACK=true

# Optional, USD per million tokens. Leave unset to report cost as null instead of guessing.
# GENERATOR_INPUT_COST_PER_MTOK=
# GENERATOR_OUTPUT_COST_PER_MTOK=
# EVALUATOR_INPUT_COST_PER_MTOK=
# EVALUATOR_OUTPUT_COST_PER_MTOK=

# --- Limits ---------------------------------------------------------------
MIN_LESSON_WORDS=500
MAX_LESSON_WORDS=6000
MAX_REFERENCE_CHARS=20000
RATE_LIMIT_PER_MINUTE=20

# --- Memory and self-evolution -------------------------------------------
MEMORY_PATTERN_MIN_OCCURRENCES=2
EVOLUTION_MIN_FAILURES=3
EVOLUTION_MIN_STRATEGY_SUCCESSES=2
EVOLUTION_INCLUDE_DEMO_RUNS=true
